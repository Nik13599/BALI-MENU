{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Code.gs",
      "*.md",
      "firestore.rules",
      "scripts/**",
      "tests/**",
      "*.json",
      "*.yaml",
      "*.yml",
      "**/*.test.js",
      "functions/**"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "privileges",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
