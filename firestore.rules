rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'name', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.email == request.auth.token.email
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string
        && data.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if signedInAs(uid) || isAdmin() || isDirector();
      allow list: if isAdmin();
      allow create: if signedInAs(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name','phone','updatedAt']);
      allow delete: if false;
    }

    // Only the signed-in owner may access a compact private avatar.
    match /users/{uid}/profileMedia/{mediaId} {
      allow get: if mediaId == 'avatar' && signedInAs(uid);
      allow list, delete: if false;
      allow create, update: if mediaId == 'avatar' && signedInAs(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasAll(['image','updatedAt'])
        && request.resource.data.keys().hasOnly(['image','updatedAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 94000
        && request.resource.data.image.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time;
    }

    // BALI ID is a non-payment, non-monetary club privilege card.
    // One-time, immutable acknowledgement of the BALI ID programme.
    // Stored separately from registration; the ID cannot be created first.
    function baliIdAgreementPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/baliIdAgreements/privilege;
    }
    function hasBaliIdAgreement(uid) {
      return exists(baliIdAgreementPath(uid))
        && get(baliIdAgreementPath(uid)).data.version == 1;
    }
    match /users/{uid}/baliIdAgreements/{agreementId} {
      allow get: if agreementId == 'privilege' && signedInAs(uid);
      allow list: if false;
      allow create: if agreementId == 'privilege' && signedInAs(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasAll(['version','acceptedAt'])
        && request.resource.data.keys().hasOnly(['version','acceptedAt'])
        && request.resource.data.version == 1
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    // BALI ID: a globally sequential six-digit-or-longer guest number.
    // ID and counter MUST be created/updated in the SAME Firestore transaction.
    // The counter's lastUid is a witness to prevent arbitrary increments or gaps.
    function baliIdPath(uid) {
      return /databases/$(database)/documents/baliIds/$(uid);
    }
    function baliIdCounterPath() {
      return /databases/$(database)/documents/baliCounters/guests;
    }
    function validBaliId(uid) {
      return request.resource.data.keys().hasAll(['uid','number','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','number','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.number is int
        && request.resource.data.number >= 1
        && request.resource.data.number <= 999999999
        && request.resource.data.createdAt == request.time
        && getAfter(baliIdCounterPath()).data.count == request.resource.data.number
        && getAfter(baliIdCounterPath()).data.lastUid == uid
        && getAfter(baliIdCounterPath()).data.updatedAt == request.time;
    }
    match /baliIds/{uid} {
      allow get: if signedInAs(uid) || isAdmin() || isDirector();
      allow list: if isAdmin() || isDirector();
      allow create: if signedInAs(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && hasBaliIdAgreement(uid)
        && validBaliId(uid);
      allow update, delete: if false;
    }
    function validBaliCounter() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hasBaliIdAgreement(request.auth.uid)
        && request.resource.data.keys().hasAll(['count','lastUid','updatedAt'])
        && request.resource.data.keys().hasOnly(['count','lastUid','updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count >= 1 && request.resource.data.count <= 999999999
        && request.resource.data.lastUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && !exists(baliIdPath(request.auth.uid))
        && getAfter(baliIdPath(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(baliIdPath(request.auth.uid)).data.number == request.resource.data.count
        && getAfter(baliIdPath(request.auth.uid)).data.createdAt == request.time;
    }
    match /baliCounters/{key} {
      allow get: if key == 'guests' && request.auth != null
        && request.auth.token.email_verified == true;
      allow list, delete: if false;
      allow create: if key == 'guests'
        && validBaliCounter() && request.resource.data.count == 1;
      allow update: if key == 'guests'
        && validBaliCounter()
        && request.resource.data.count == resource.data.count + 1;
    }
    // Newly registered guests may create ONLY their default Member card.
    // All later upgrades and personal benefits require a director or admin.
    function validPrivilege(data, uid) {
      return data.keys().hasAll(['uid','tier','benefits','updatedAt','updatedBy'])
        && data.keys().hasOnly(['uid','tier','benefits','updatedAt','updatedBy'])
        && data.uid == uid
        && data.tier in ['Member','Silver','Gold','Platinum','Black','Private','ResidentDJ']
        && data.benefits is list && data.benefits.size() <= 5
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }
    match /guestPrivileges/{uid} {
      allow get: if signedInAs(uid) || isAdmin() || isDirector();
      allow list: if isAdmin();
      allow create: if exists(/databases/$(database)/documents/users/$(uid))
        && hasBaliIdAgreement(uid)
        && validPrivilege(request.resource.data,uid)
        && ((isAdmin() || isDirector()) ||
           (signedInAs(uid)
             && request.resource.data.tier == 'Member'
             && request.resource.data.benefits.size() == 0));
      allow update: if (isAdmin() || isDirector())
        && exists(/databases/$(database)/documents/users/$(uid))
        && validPrivilege(request.resource.data,uid);
      allow delete: if false;
    }
    match /privilegeRules/{id} {
      allow get: if id == 'main' && request.auth != null;
      allow list, delete: if false;
      allow create, update: if id == 'main' && isAdmin()
        && request.resource.data.keys().hasAll(['levels','updatedAt'])
        && request.resource.data.keys().hasOnly(['levels','updatedAt'])
        && request.resource.data.levels is map
        && request.resource.data.levels.keys().hasAll(['Member','Silver','Gold','Platinum','Black','Private','ResidentDJ'])
        && request.resource.data.levels.keys().hasOnly(['Member','Silver','Gold','Platinum','Black','Private','ResidentDJ'])
        && request.resource.data.updatedAt == request.time;
    }

    // 18+ self-attestation, stored only for a verified user's profile.
    // A visitor without an account never gets a stored confirmation.
    match /users/{uid}/ageConfirmations/{consentId} {
      allow get: if consentId == 'restrictedMenus' && signedInAs(uid);
      allow list: if false;
      allow create, update: if consentId == 'restrictedMenus' && signedInAs(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasAll(['over18','confirmedAt'])
        && request.resource.data.keys().hasOnly(['over18','confirmedAt'])
        && request.resource.data.over18 == true
        && request.resource.data.confirmedAt == request.time;
      allow delete: if false;
    }

    // Служебная роль назначается вручную в Firebase Console.
    // Клиент не может назначить себе права администратора.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // The director role is assigned manually by the Firebase project owner.
    // Visitors cannot self-assign staff roles; admins keep their existing role.
    function isDirector() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.role == 'director'
        && get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.active == true;
    }
    match /staffRoles/{uid} {
      allow get: if signedInAs(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if signedInAs(uid);
      allow list, create, update, delete: if false;
    }

    // Только глобальная палитра доступна для публичного чтения.
    // Записывать её могут только проверенные администраторы.
    // Цвет фона не входит в настраиваемые поля.
    function validAppearance(data) {
      return data.keys().hasAll(['theme','colors','updatedAt'])
        && data.keys().hasOnly(['theme','colors','updatedAt'])
        && data.theme in ['cobalt','lime','white','custom']
        && data.colors is map
        && data.colors.keys().hasAll(['primary','secondary','text','border'])
        && data.colors.keys().hasOnly(['primary','secondary','text','border'])
        && data.colors.primary is string
        && data.colors.primary.matches('^#[0-9A-Fa-f]{6}$')
        && data.colors.secondary is string
        && data.colors.secondary.matches('^#[0-9A-Fa-f]{6}$')
        && data.colors.text is string
        && data.colors.text.matches('^#[0-9A-Fa-f]{6}$')
        && data.colors.border is string
        && data.colors.border.matches('^#[0-9A-Fa-f]{6}$')
        && data.updatedAt == request.time;
    }

    // Section switches only control public navigation/visibility.
    // Products stay intact and remain writable only by administrators.
    function validMenuVisibility(data) {
      return data.keys().hasAll(['sections','updatedAt'])
        && data.keys().hasOnly(['sections','updatedAt'])
        && data.sections is map
        && data.sections.keys().hasAll(['kitchen','bar','hookah','tea'])
        && data.sections.keys().hasOnly(['kitchen','bar','hookah','tea'])
        && data.sections.kitchen is bool
        && data.sections.bar is bool
        && data.sections.hookah is bool
        && data.sections.tea is bool
        && data.updatedAt == request.time;
    }

    // Admin-uploaded photographs are compressed to WebP, with optional HTTPS links.
    function validDesignImage(v,maxChars) {
      return v is string && v.size() <= maxChars
        && (v == '' || v.matches('^https://.+')
          || v.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'));
    }
    function validHomeDesign(d) {
      return d.keys().hasAll(['aboutTitle','aboutSubtitle','aboutDescription','aboutImageUrl',
        'aboutImageTabletUrl','aboutImageMobileUrl','updatedAt'])
        && d.keys().hasOnly(['aboutTitle','aboutSubtitle','aboutDescription','aboutImageUrl',
          'aboutImageTabletUrl','aboutImageMobileUrl','updatedAt'])
        && d.aboutTitle is string && d.aboutTitle.size() <= 50
        && d.aboutSubtitle is string && d.aboutSubtitle.size() <= 85
        && d.aboutDescription is string && d.aboutDescription.size() <= 450
        && validDesignImage(d.aboutImageUrl, 125000)
        && validDesignImage(d.aboutImageTabletUrl, 125000)
        && validDesignImage(d.aboutImageMobileUrl, 125000)
        && (d.aboutTitle.size() > 0 || d.aboutSubtitle.size() > 0 ||
          d.aboutDescription.size() > 0 || d.aboutImageUrl.size() > 0)
        && d.updatedAt == request.time;
    }
    function validMerch(d) {
      return d.keys().hasAll(['name','description','imageUrl','imageTabletUrl','imageMobileUrl',
        'status','price','sort','published','updatedAt'])
        && d.keys().hasOnly(['name','description','imageUrl','imageTabletUrl','imageMobileUrl',
          'status','price','sort','published','updatedAt'])
        && d.name is string && (d.name.size() == 0 || (d.name.size() >= 2 && d.name.size() <= 95))
        && d.description is string && d.description.size() <= 180
        && validDesignImage(d.imageUrl, 125000)
        && validDesignImage(d.imageTabletUrl, 125000)
        && validDesignImage(d.imageMobileUrl, 125000)
        && d.status in ['soon','available']
        && d.price is number && d.price >= 0 && d.price <= 20000
        && (d.status == 'soon' || d.price > 0)
        && d.sort is int && d.sort >= 0 && d.sort <= 100000
        && d.published is bool
        && (d.name.size() > 0 || d.description.size() > 0 || d.imageUrl.size() > 0)
        && d.updatedAt == request.time;
    }

    // Site-wide labels and small device-safe icons; public read, admin-only edits.
    function validHomeInterface(d) {
      return d.keys().hasAll([
          'brandTitle','brandSubtitle','navHomeText','navCalendarText','navMenuText',
          'navCartText','calendarPreviewTitle','calendarPageTitle','menuPageTitle','menuBannerTitle',
          'menuBannerCta','contactHeading','phoneText','phoneHref','telegramChatUrl','telegramUrl',
          'instagramUrl','tiktokUrl','findHeading','addressText','addressFloor','mapUrl','icons','updatedAt'])
        && d.keys().hasOnly([
          'brandTitle','brandSubtitle','navHomeText','navCalendarText','navMenuText',
          'navCartText','calendarPreviewTitle','calendarPageTitle','menuPageTitle','menuBannerTitle',
          'menuBannerCta','contactHeading','phoneText','phoneHref','telegramChatUrl','telegramUrl',
          'instagramUrl','tiktokUrl','findHeading','addressText','addressFloor','mapUrl','icons','updatedAt'])
        && d.brandTitle is string && d.brandTitle.size() >= 1 && d.brandTitle.size() <= 32
        && d.brandSubtitle is string && d.brandSubtitle.size() >= 1 && d.brandSubtitle.size() <= 35
        && d.navHomeText is string && d.navHomeText.size() >= 1 && d.navHomeText.size() <= 30
        && d.navCalendarText is string && d.navCalendarText.size() >= 1 && d.navCalendarText.size() <= 30
        && d.navMenuText is string && d.navMenuText.size() >= 1 && d.navMenuText.size() <= 30
        && d.navCartText is string && d.navCartText.size() >= 1 && d.navCartText.size() <= 30
        && d.calendarPreviewTitle is string && d.calendarPreviewTitle.size() >= 1 && d.calendarPreviewTitle.size() <= 55
        && d.calendarPageTitle is string && d.calendarPageTitle.size() >= 1 && d.calendarPageTitle.size() <= 55
        && d.menuPageTitle is string && d.menuPageTitle.size() >= 1 && d.menuPageTitle.size() <= 55
        && d.menuBannerTitle is string && d.menuBannerTitle.size() >= 1 && d.menuBannerTitle.size() <= 45
        && d.menuBannerCta is string && d.menuBannerCta.size() >= 1 && d.menuBannerCta.size() <= 65
        && d.contactHeading is string && d.contactHeading.size() >= 1 && d.contactHeading.size() <= 55
        && d.phoneText is string && d.phoneText.size() >= 1 && d.phoneText.size() <= 32
        && d.phoneHref is string && d.phoneHref.matches('^tel:[+][0-9]{5,22}$')
        && d.telegramChatUrl is string && d.telegramChatUrl.size() <= 250 && d.telegramChatUrl.matches('^https://.+')
        && d.telegramUrl is string && d.telegramUrl.size() <= 250 && d.telegramUrl.matches('^https://.+')
        && d.instagramUrl is string && d.instagramUrl.size() <= 250 && d.instagramUrl.matches('^https://.+')
        && d.tiktokUrl is string && d.tiktokUrl.size() <= 250
        && (d.tiktokUrl == '' || d.tiktokUrl.matches('^https://.+'))
        && d.findHeading is string && d.findHeading.size() >= 1 && d.findHeading.size() <= 50
        && d.addressText is string && d.addressText.size() >= 1 && d.addressText.size() <= 110
        && d.addressFloor is string && d.addressFloor.size() >= 1 && d.addressFloor.size() <= 80
        && d.mapUrl is string && d.mapUrl.size() <= 300 && d.mapUrl.matches('^https://.+')
        && d.icons is map
        && d.icons.keys().hasAll(['navHome','navCalendar','navMenu','navCart',
          'calendar','menuBanner','phone','telegram','instagram','map'])
        && d.icons.keys().hasOnly(['navHome','navCalendar','navMenu','navCart',
          'calendar','menuBanner','phone','telegram','instagram','map'])
        && validDesignImage(d.icons.navHome,24000)
        && validDesignImage(d.icons.navCalendar,24000)
        && validDesignImage(d.icons.navMenu,24000)
        && validDesignImage(d.icons.navCart,24000)
        && validDesignImage(d.icons.calendar,24000)
        && validDesignImage(d.icons.menuBanner,24000)
        && validDesignImage(d.icons.phone,24000)
        && validDesignImage(d.icons.telegram,24000)
        && validDesignImage(d.icons.instagram,24000)
        && validDesignImage(d.icons.map,24000)
        && d.updatedAt == request.time;
    }

    // One shared artistic card for empty places on the PC HOME page.
    function validHomeEventPlaceholder(d) {
      return d.keys().hasAll([
          'posterTitle','kicker','footerTitle','footerSubtitle',
          'imageUrl','accentColor','backgroundColor','updatedAt'])
        && d.keys().hasOnly([
          'posterTitle','kicker','footerTitle','footerSubtitle',
          'imageUrl','accentColor','backgroundColor','updatedAt'])
        && d.posterTitle is string && d.posterTitle.size() >= 1 && d.posterTitle.size() <= 40
        && d.kicker is string && d.kicker.size() >= 1 && d.kicker.size() <= 42
        && d.footerTitle is string && d.footerTitle.size() >= 1 && d.footerTitle.size() <= 52
        && d.footerSubtitle is string && d.footerSubtitle.size() >= 1 && d.footerSubtitle.size() <= 85
        && validDesignImage(d.imageUrl, 120000)
        && d.accentColor is string && d.accentColor.matches('^#[0-9A-Fa-f]{6}$')
        && d.backgroundColor is string && d.backgroundColor.matches('^#[0-9A-Fa-f]{6}$')
        && d.updatedAt == request.time;
    }

    // Visual site builder stores unpublished drafts separately from public layouts.
    // Presentation overrides cannot write menus, orders, BALI ID or staff privileges.
    function validSiteBuilderDevice(device) {
      return device is map
        && device.keys().hasAll(['rules','blocks'])
        && device.keys().hasOnly(['rules','blocks'])
        && device.rules is map && device.rules.size() <= 140
        && device.blocks is list && device.blocks.size() <= 30;
    }
    function validSiteBuilder(d) {
      return d.keys().hasAll(['schemaVersion','desktop','tablet','phone','updatedAt'])
        && d.keys().hasOnly(['schemaVersion','desktop','tablet','phone','updatedAt'])
        && d.schemaVersion == 1
        && validSiteBuilderDevice(d.desktop)
        && validSiteBuilderDevice(d.tablet)
        && validSiteBuilderDevice(d.phone)
        && d.updatedAt == request.time;
    }

    match /settings/{settingId} {
      allow get: if settingId in ['appearance','menuVisibility','homeDesign','homeInterface','homeEventPlaceholder','siteBuilderPublished']
        || (settingId == 'siteBuilderDraft' && isAdmin());
      allow list: if false;
      allow create, update: if isAdmin()
        && ((settingId == 'appearance' && validAppearance(request.resource.data))
            || (settingId == 'menuVisibility' && validMenuVisibility(request.resource.data))
            || (settingId == 'homeDesign' && validHomeDesign(request.resource.data))
            || (settingId == 'homeInterface' && validHomeInterface(request.resource.data))
            || (settingId == 'homeEventPlaceholder' && validHomeEventPlaceholder(request.resource.data))
            || (settingId in ['siteBuilderDraft','siteBuilderPublished'] && validSiteBuilder(request.resource.data)));
      allow delete: if false;
    }


    // Independently managed MOBILE About backgrounds, not the desktop About
    // settings. Guests can only query published photos; verified admins edit.
    function validMobileAboutBackground(d) {
      return d.keys().hasAll(['imageUrl','sort','published','updatedAt'])
        && d.keys().hasOnly(['imageUrl','sort','published','updatedAt'])
        && validDesignImage(d.imageUrl, 125000)
        && d.imageUrl.size() > 0
        && d.sort is int && d.sort >= 0 && d.sort <= 100000
        && d.published is bool
        && d.updatedAt == request.time;
    }
    match /mobileAboutBackgrounds/{backgroundId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validMobileAboutBackground(request.resource.data);
      allow delete: if isAdmin();
    }

    match /merch/{merchId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validMerch(request.resource.data);
      allow delete: if isAdmin();
    }

    // BALI PRIVILEGE: visitors may query ONLY published offers.
    // Drafts and editing are restricted to verified staff admins.
    function validPromoContactLinks(links) {
      return links is map
        && links.keys().hasAll(['phone','telegram','instagram','whatsapp','viber']) && links.keys().hasOnly(['phone','telegram','instagram','whatsapp','viber'])
        && links.phone is string && links.phone.size() <= 300
        && links.telegram is string && links.telegram.size() <= 300
        && links.instagram is string && links.instagram.size() <= 300
        && links.whatsapp is string && links.whatsapp.size() <= 300
        && links.viber is string && links.viber.size() <= 300;
    }
    function validPromoContactEnabled(enabled) {
      return enabled is map
        && enabled.keys().hasAll(['phone','telegram','instagram','whatsapp','viber']) && enabled.keys().hasOnly(['phone','telegram','instagram','whatsapp','viber'])
        && enabled.phone is bool
        && enabled.telegram is bool
        && enabled.instagram is bool
        && enabled.whatsapp is bool
        && enabled.viber is bool;
    }
    function validPromoHotspot(spot) {
      return spot is map
        && spot.keys().hasAll(['enabled','left','top','width','height'])
        && spot.keys().hasOnly(['enabled','left','top','width','height'])
        && spot.enabled is bool
        && spot.left is int && spot.left >= 0
        && spot.top is int && spot.top >= 0
        && spot.width is int && spot.width >= 1
        && spot.height is int && spot.height >= 1
        && spot.left + spot.width <= 100 && spot.top + spot.height <= 100;
    }
    function validPromoOverlay(layer) {
      return layer is map
        && layer.keys().hasAll(['enabled','fontSize','textColor','buttonBackground','buttonColor','buttonRadius','align'])
        && layer.keys().hasOnly(['enabled','fontSize','textColor','buttonBackground','buttonColor','buttonRadius','align'])
        && layer.enabled is bool
        && layer.fontSize is int && layer.fontSize >= 12 && layer.fontSize <= 80
        && layer.textColor is string && layer.textColor.matches('^#[0-9a-fA-F]{6}$')
        && layer.buttonBackground is string && layer.buttonBackground.matches('^#[0-9a-fA-F]{6}$')
        && layer.buttonColor is string && layer.buttonColor.matches('^#[0-9a-fA-F]{6}$')
        && layer.buttonRadius is int && layer.buttonRadius >= 0 && layer.buttonRadius <= 48
        && layer.align in ['left','center','right'];
    }
    function validPromotion(data) {
      return data.keys().hasAll(['title','description','imageUrl','imageTabletUrl','imageMobileUrl','destination','buttonText','sort','published','updatedAt'])
        && data.keys().hasOnly(['title','description','imageUrl','imageTabletUrl','imageMobileUrl','destination','buttonText','contactTitle','contactLinks','contactEnabled','contactHotspot','overlay','imageRemoved','sort','published','updatedAt'])
        && (!('contactTitle' in data) || (data.contactTitle is string && data.contactTitle.size() <= 70))
        && (!('contactLinks' in data) || validPromoContactLinks(data.contactLinks))
        && (!('contactEnabled' in data) || validPromoContactEnabled(data.contactEnabled))
        && (!('contactHotspot' in data) || validPromoHotspot(data.contactHotspot))
        && (!('overlay' in data) || validPromoOverlay(data.overlay))
        && (!('imageRemoved' in data) || data.imageRemoved is bool)
        && data.title is string && (data.title.size() == 0 || (data.title.size() >= 2 && data.title.size() <= 100))
        && data.description is string && data.description.size() <= 260
        && validDesignImage(data.imageUrl, 155000)
        && validDesignImage(data.imageTabletUrl, 155000)
        && validDesignImage(data.imageMobileUrl, 155000)
        && data.destination in ['none','menu','events','contacts','contact-modal']
        && data.buttonText is string && data.buttonText.size() <= 65
        && (data.destination != 'contact-modal' || data.keys().hasAll(['contactTitle','contactLinks','contactEnabled']))
        && data.sort is int && data.sort >= 0 && data.sort <= 100000
        && data.published is bool
        && (data.title.size() > 0 || data.description.size() > 0 || data.imageUrl.size() > 0)
        && data.updatedAt == request.time;
    }
    match /promotions/{promotionId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validPromotion(request.resource.data);
      allow delete: if isAdmin();
    }

    // Публичная барная карта — только для ознакомления. Никогда не участвует
    // в предзаказах: отдельная коллекция, запись только с ролью администратора.
    function validBarMenuItem(data) {
      return data.keys().hasAll(['name','category','volume1','price1','volume2','price2','sort','updatedAt'])
        && data.keys().hasOnly(['name','category','volume1','price1','volume2','price2','sort','updatedAt','description','ingredients'])
        && data.get('description','') is string && data.get('description','').size() <= 2400
        && data.get('ingredients','') is string && data.get('ingredients','').size() <= 2400
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.volume1 is string && data.volume1.size() >= 1 && data.volume1.size() <= 30
        && data.price1 is number && data.price1 >= 0 && data.price1 <= 20000
        && data.volume2 is string && data.volume2.size() <= 30
        && data.price2 is number && data.price2 >= 0 && data.price2 <= 20000
        && (data.volume2 != '' || data.price2 == 0)
        && data.sort is int && data.sort >= 0 && data.sort <= 100000
        && data.updatedAt == request.time;
    }

    match /bar_menu/{drinkId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && validBarMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Кальянная и чайная карты доступны для просмотра гостям,
    // но редактируются исключительно проверенным администратором.
    // Отдельные коллекции никогда не попадают в кухонные предзаказы.
    match /hookah_menu/{hookahId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && validBarMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Tea products also carry information-only fields for the kitchen-style
    // details action. Notes are optional, limited and editable by admins only.
    function validTeaMenuItem(data) {
      return data.keys().hasAll(['name','category','volume1','price1','volume2','price2','sort','updatedAt'])
        && data.keys().hasOnly([
          'name','category','volume1','price1','volume2','price2','sort','updatedAt',
          'description','ingredients','taste','brewing','sourcePage','hidden'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.volume1 is string && data.volume1.size() >= 1 && data.volume1.size() <= 30
        && data.price1 is number && data.price1 >= 0 && data.price1 <= 20000
        && data.volume2 is string && data.volume2.size() <= 30
        && data.price2 is number && data.price2 >= 0 && data.price2 <= 20000
        && (data.volume2 != '' || data.price2 == 0)
        && data.sort is int && data.sort >= 0 && data.sort <= 100000
        && data.get('description','') is string && data.get('description','').size() <= 2400
        && data.get('ingredients','') is string && data.get('ingredients','').size() <= 2400
        && data.get('taste','') is string && data.get('taste','').size() <= 2400
        && data.get('brewing','') is string && data.get('brewing','').size() <= 2400
        && data.get('sourcePage',0) is int
        && data.get('sourcePage',0) >= 0 && data.get('sourcePage',0) <= 36
        && data.get('hidden',false) is bool
        && data.updatedAt == request.time;
    }

    match /tea_menu/{teaId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && validTeaMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Самостоятельные категории доступны для чтения/редактирования
    // только аккаунтам с вручную назначенной ролью администратора.
    function validCategory(data) {
      return data.keys().hasAll(['name','sort','updatedAt'])
        && data.keys().hasOnly(['name','sort','updatedAt'])
        && data.name is string
        && data.name.size() >= 2 && data.name.size() <= 60
        && data.sort is int
        && data.sort >= 0 && data.sort <= 100000
        && data.updatedAt == request.time;
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && validCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    function validMenu(data) {
      return data.keys().hasAll(['id','name','category','description','price','image_url','available','sort','updatedAt'])
        && data.keys().hasOnly(['id','name','category','description','price','image_url','available','sort','updatedAt',
          'weight','detailEnabled','detailText','detailImageUrl'])
        && data.id is int && data.id > 0
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.description is string && data.description.size() <= 800
        && (!('weight' in data) || (data.weight is string && data.weight.size() <= 45))
        && (!('detailEnabled' in data) || data.detailEnabled is bool)
        && (!('detailText' in data) || (data.detailText is string && data.detailText.size() <= 2400))
        && (!('detailImageUrl' in data) || (data.detailImageUrl is string
          && data.detailImageUrl.size() <= 95000
          && (data.detailImageUrl == ''
             || (data.detailImageUrl.size() <= 1000 && data.detailImageUrl.matches('^https://[^ ]+$'))
             || data.detailImageUrl.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))))
        && (data.get('detailEnabled',false) == false
            || ('detailText' in data && data.detailText is string
                && data.detailText.size() >= 1 && data.detailText.matches('.*[^ ].*')))
        && data.price is number && data.price >= 0 && data.price <= 20000
        && data.image_url is string && data.image_url.size() <= 95000
        && (data.image_url == ''
          || (data.image_url.size() <= 1000 && data.image_url.matches('^https://[^ ]+$'))
          || data.image_url.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))
        && data.available is bool
        && data.sort is int && data.sort >= 0 && data.sort <= 100000
        && data.updatedAt == request.time;
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validMenu(request.resource.data)
        && itemId == string(request.resource.data.id);
      allow delete: if isAdmin();
    }

    function validInterestCountChange(date) {
      let previous = resource.data.get('interestCount', 0);
      let next = request.resource.data.get('interestCount', 0);
      let mine = /databases/$(database)/documents/users/$(request.auth.uid)/eventInterests/$(date);
      return request.auth != null
        && request.auth.token.email_verified == true
        && previous is int && previous >= 0
        && next is int && next >= 0 && next <= 1000000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestCount'])
        && (
          (!exists(mine) && existsAfter(mine) && next == previous + 1)
          || (exists(mine) && !existsAfter(mine) && next == previous - 1)
        );
    }

    // Private, immutable self-reported check-in, distinct from RSVP/plans.
    match /users/{uid}/eventCheckins/{eventId} {
      allow get, list: if signedInAs(uid) || isAdmin();
      allow create: if signedInAs(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && exists(/databases/$(database)/documents/events/$(eventId))
        && request.resource.data.keys().hasOnly(['uid','eventDate','createdAt'])
        && request.resource.data.keys().hasAll(['uid','eventDate','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.eventDate == get(/databases/$(database)/documents/events/$(eventId)).data.date
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid}/eventInterests/{eventDate} {
      allow get, list: if signedInAs(uid) || isAdmin();
      allow create: if signedInAs(uid)
        && exists(/databases/$(database)/documents/events/$(eventDate))
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'eventDate', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'eventDate', 'createdAt'])
        && request.resource.data.uid == uid
        && (eventDate == request.resource.data.eventDate
          || eventDate == request.resource.data.eventDate + '__2'
          || eventDate == request.resource.data.eventDate + '__3')
        && request.resource.data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/events/$(eventDate)).data.get('interestCount', 0)
          == get(/databases/$(database)/documents/events/$(eventDate)).data.get('interestCount', 0) + 1;
      allow update: if false;
      allow delete: if signedInAs(uid)
        && exists(/databases/$(database)/documents/events/$(eventDate))
        && getAfter(/databases/$(database)/documents/events/$(eventDate)).data.get('interestCount', 0)
          == get(/databases/$(database)/documents/events/$(eventDate)).data.get('interestCount', 0) - 1;
    }

    function validEvent(data, eventId) {
      return data.keys().hasAll(['date','title','preorderEnabled','cutoff','closesAt','updatedAt'])
        && data.keys().hasOnly(['date','title','preorderEnabled','cutoff','closesAt','poster_url','interestCount','updatedAt','description','startTime','endTime','dotColor'])
        && (!('interestCount' in data) || (
          data.interestCount is int
          && data.interestCount >= 0 && data.interestCount <= 1000000
        ))
        && (!('poster_url' in data) || (
          data.poster_url is string
          && data.poster_url.size() <= 150000
          && (data.poster_url == ''
            || (data.poster_url.size() <= 1000 && data.poster_url.matches('^https://[^ ]+$'))
            || data.poster_url.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))
        ))
        && data.date is string
        && (eventId == data.date || eventId == data.date + '__2' || eventId == data.date + '__3')
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 150
        && (!('dotColor' in data) || (data.dotColor is string && data.dotColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && (!('startTime' in data) || (data.startTime is string &&
          (data.startTime == '' || data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))))
        && (!('endTime' in data) || (data.endTime is string &&
          (data.endTime == '' || data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))))
        && (('startTime' in data) == ('endTime' in data))
        && (!('startTime' in data) || (data.startTime == '' && data.endTime == '') ||
            (data.startTime != '' && data.endTime != ''))
        && data.preorderEnabled is bool
        && data.closesAt is timestamp
        && data.cutoff is string
        && (data.cutoff == '' || data.cutoff.matches('^[0-2][0-9]:[0-5][0-9]$'))
        && data.updatedAt == request.time;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && validEvent(request.resource.data, eventId);
      allow update: if (isAdmin() && validEvent(request.resource.data, eventId))
        || validInterestCountChange(eventId);
      allow delete: if isAdmin();
    }

    // БЕСПЛАТНЫЕ ПРЕДЗАКАЗЫ — без доверия к стоимости и UID из браузера.
    // Строки хранятся отдельно в orders/{id}/items/{menuId}.
    // Цена, название и наличие каждой позиции проверяются по /menu/{menuId}.
    function hasProfile() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function canOrderFor(date) {
      return exists(/databases/$(database)/documents/events/$(date))
        && get(/databases/$(database)/documents/events/$(date)).data.preorderEnabled == true
        && get(/databases/$(database)/documents/events/$(date)).data.closesAt is timestamp
        && request.time < get(/databases/$(database)/documents/events/$(date)).data.closesAt;
    }

    // Отдельный атомарный счётчик для каждого eventId (включая __2 и __3).
    // Старый счётчик YYYY-MM-DD остаётся для первого мероприятия этой даты.
    function counterPath(eventId) {
      return /databases/$(database)/documents/orderCounters/$(eventId);
    }
    function validOrderSequence(eventId, number, orderId) {
      return number is int && number >= 1 && number <= 999999
        && getAfter(counterPath(eventId)).data.count == number
        && getAfter(counterPath(eventId)).data.lastOrderId == orderId;
    }
    function validCounter(eventId) {
      return request.resource.data.keys().hasAll(['date','count','lastOrderId','updatedAt'])
        && request.resource.data.keys().hasOnly(['date','count','lastOrderId','updatedAt'])
        && request.resource.data.date is string
        && (eventId == request.resource.data.date
          || eventId == request.resource.data.date + '__2'
          || eventId == request.resource.data.date + '__3')
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
        && request.resource.data.count is int
        && request.resource.data.count >= 1 && request.resource.data.count <= 999999
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderId.size() >= 10
        && request.resource.data.lastOrderId.size() <= 120
        && request.resource.data.updatedAt == request.time;
    }
    function counterWitness(eventId) {
      let order = /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId);
      return getAfter(order).data.eventDate == request.resource.data.date
        && getAfter(order).data.get('eventId',getAfter(order).data.eventDate) == eventId
        && getAfter(order).data.orderNumber == request.resource.data.count
        && (getAfter(order).data.ownerUid == request.auth.uid || isAdmin())
        && (
          (!exists(order) && getAfter(order).data.createdAt == request.time)
          || (exists(order)
              && get(order).data.get('eventId',get(order).data.eventDate) != eventId
              && getAfter(order).data.updatedAt == request.time)
        );
    }
    match /orderCounters/{eventId} {
      allow get: if request.auth != null && request.auth.token.email_verified == true;
      allow list, delete: if false;
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && validCounter(eventId) && request.resource.data.count == 1
        && counterWitness(eventId);
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && validCounter(eventId)
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastOrderId != resource.data.lastOrderId
        && counterWitness(eventId);
    }

    function orderShape(data) {
      return data.keys().hasAll([
          'ownerUid','email','customerName','customerPhone','eventDate',
          'tableNumber','bookingId','notes','status','createdAt','updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid','email','customerName','customerPhone','eventDate',
          'tableNumber','bookingId','notes','status','archived','orderNumber','eventId','eventTitle','createdAt','updatedAt'
        ])
        && (!('archived' in data) || data.archived is bool)
        && (!('orderNumber' in data) || (data.orderNumber is int
          && data.orderNumber >= 1 && data.orderNumber <= 999999))
        && data.ownerUid is string
        && data.email is string
        && data.customerName is string
        && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.customerPhone is string
        && data.customerPhone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.eventDate is string
        && data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('eventId' in data) || (data.eventId is string &&
          (data.eventId == data.eventDate || data.eventId == data.eventDate + '__2' || data.eventId == data.eventDate + '__3')))
        && (!('eventTitle' in data) || (data.eventTitle is string
          && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 150))
        && data.tableNumber is string && data.tableNumber.size() <= 20
        && data.bookingId is string && data.bookingId.size() <= 60
        && (data.tableNumber.size() > 0 || data.bookingId.size() > 0)
        && data.notes is string && data.notes.size() <= 500
        && data.status in ['pending','confirmed','completed','cancelled']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function ownerOfOrder(data) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && data.ownerUid == request.auth.uid;
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin() || (
        request.auth != null && request.auth.token.email_verified == true
        && resource.data.ownerUid == request.auth.uid
      );

      allow create: if hasProfile()
        && orderShape(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.customerName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.customerPhone ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
        && request.resource.data.status == 'pending'
        && validOrderSequence(request.resource.data.get('eventId',request.resource.data.eventDate),
          request.resource.data.orderNumber,orderId)
        && (!('archived' in request.resource.data) || request.resource.data.archived == false)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && canOrderFor(request.resource.data.get('eventId', request.resource.data.eventDate))
        && ('eventTitle' in request.resource.data)
        && request.resource.data.eventTitle ==
          get(/databases/$(database)/documents/events/$(request.resource.data.get('eventId',request.resource.data.eventDate))).data.title;

      allow update: if orderShape(request.resource.data)
        && (
          (request.resource.data.get('eventId',request.resource.data.eventDate)
              == resource.data.get('eventId',resource.data.eventDate)
            && request.resource.data.eventDate == resource.data.eventDate
            && request.resource.data.get('orderNumber',0) == resource.data.get('orderNumber',0))
          || (request.resource.data.get('eventId',request.resource.data.eventDate)
              != resource.data.get('eventId',resource.data.eventDate)
            && validOrderSequence(request.resource.data.get('eventId',request.resource.data.eventDate),
              request.resource.data.orderNumber,orderId))
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.email == resource.data.email
        && (request.resource.data.customerName == resource.data.customerName || isAdmin())
        && (request.resource.data.customerPhone == resource.data.customerPhone || isAdmin())
        && request.resource.data.updatedAt == request.time
        && (
          // Посетитель редактирует данные только до подтверждения администратором.
          (
            ownerOfOrder(resource.data)
            && resource.data.status == 'pending'
            && (!('archived' in resource.data) || resource.data.archived == false)
            && (
              (
                request.resource.data.status == 'pending'
                && canOrderFor(request.resource.data.get('eventId', request.resource.data.eventDate))
                && request.resource.data.get('eventTitle', '') ==
                  get(/databases/$(database)/documents/events/$(request.resource.data.get('eventId',request.resource.data.eventDate))).data.title
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['eventDate','eventId','eventTitle','orderNumber','tableNumber','bookingId','notes','updatedAt'])
              )
              || (
                request.resource.data.status == 'cancelled'
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status','updatedAt'])
              )
            )
          )
          ||
          // Администратор редактирует заказ без права менять владельца и email.
          (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'customerName','customerPhone','eventDate','eventId','eventTitle','orderNumber','tableNumber','bookingId',
                  'notes','status','archived','updatedAt'
                ])
            && (
              !('archived' in request.resource.data)
              || request.resource.data.archived == false
              || request.resource.data.status == 'cancelled'
            )
          )
        );

      allow delete: if false;

      match /items/{menuId} {
        function parentPath() {
          return /databases/$(database)/documents/orders/$(orderId);
        }
        function ownEditableOrder() {
          return request.auth != null
            && request.auth.token.email_verified == true
            && getAfter(parentPath()).data.ownerUid == request.auth.uid
            && getAfter(parentPath()).data.status == 'pending'
            && canOrderFor(getAfter(parentPath()).data.get('eventId',getAfter(parentPath()).data.eventDate));
        }
        function validItem(data) {
          return data.keys().hasAll(['id','name','unitPrice','quantity'])
            && data.keys().hasOnly(['id','name','unitPrice','quantity'])
            && data.id is int && data.id > 0
            && menuId == string(data.id)
            && data.quantity is int
            && data.quantity >= 1 && data.quantity <= 50
            && exists(/databases/$(database)/documents/menu/$(menuId))
            && get(/databases/$(database)/documents/menu/$(menuId)).data.available == true
            && data.name == get(/databases/$(database)/documents/menu/$(menuId)).data.name
            && data.unitPrice == get(/databases/$(database)/documents/menu/$(menuId)).data.price;
        }
        allow get, list: if isAdmin() || (
          request.auth != null && request.auth.token.email_verified == true
          && get(parentPath()).data.ownerUid == request.auth.uid
        );
        allow create, update: if (ownEditableOrder() || isAdmin())
          && validItem(request.resource.data);
        allow delete: if ownEditableOrder() || isAdmin();
      }
    }

    // FUTURE BALI ID bonus transfers. Cloud Functions must perform BOTH wallet
    // updates and the audit entry in one server-side Firestore transaction.
    // NEVER allow a browser (including directors) to write these documents.
    match /guestWallets/{uid} {
      allow get: if signedInAs(uid) || isAdmin() || isDirector();
      allow list, create, update, delete: if false;
    }
    match /bonusTransfers/{transferId} {
      allow read, write: if false;
    }
    match /baliTransferInbox/{uid}/items/{transferId} {
      allow get, list: if signedInAs(uid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.count is int
        && request.resource.data.count >= 1 && request.resource.data.count <= 999999
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderId.size() >= 10
        && request.resource.data.lastOrderId.size() <= 120
        && request.resource.data.updatedAt == request.time;
    }
    function counterWitness(date) {
      let order = /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId);
      return getAfter(order).data.eventDate == date
        && getAfter(order).data.orderNumber == request.resource.data.count
        && (getAfter(order).data.ownerUid == request.auth.uid || isAdmin())
        && (
          (!exists(order) && getAfter(order).data.createdAt == request.time)
          || (exists(order) && get(order).data.eventDate != date
              && getAfter(order).data.updatedAt == request.time)
        );
    }
    match /orderCounters/{date} {
      allow get: if request.auth != null && request.auth.token.email_verified == true;
      allow list, delete: if false;
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && validCounter(date) && request.resource.data.count == 1
        && counterWitness(date);
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && validCounter(date)
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastOrderId != resource.data.lastOrderId
        && counterWitness(date);
    }

    function orderShape(data) {
      return data.keys().hasAll([
          'ownerUid','email','customerName','customerPhone','eventDate',
          'tableNumber','bookingId','notes','status','createdAt','updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid','email','customerName','customerPhone','eventDate',
          'tableNumber','bookingId','notes','status','archived','orderNumber','eventId','eventTitle','createdAt','updatedAt'
        ])
        && (!('archived' in data) || data.archived is bool)
        && (!('orderNumber' in data) || (data.orderNumber is int
          && data.orderNumber >= 1 && data.orderNumber <= 999999))
        && data.ownerUid is string
        && data.email is string
        && data.customerName is string
        && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.customerPhone is string
        && data.customerPhone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.eventDate is string
        && data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('eventId' in data) || (data.eventId is string &&
          (data.eventId == data.eventDate || data.eventId == data.eventDate + '__2' || data.eventId == data.eventDate + '__3')))
        && (!('eventTitle' in data) || (data.eventTitle is string
          && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 150))
        && data.tableNumber is string && data.tableNumber.size() <= 20
        && data.bookingId is string && data.bookingId.size() <= 60
        && (data.tableNumber.size() > 0 || data.bookingId.size() > 0)
        && data.notes is string && data.notes.size() <= 500
        && data.status in ['pending','confirmed','completed','cancelled']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function ownerOfOrder(data) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && data.ownerUid == request.auth.uid;
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin() || (
        request.auth != null && request.auth.token.email_verified == true
        && resource.data.ownerUid == request.auth.uid
      );

      allow create: if hasProfile()
        && orderShape(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.customerName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.customerPhone ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
        && request.resource.data.status == 'pending'
        && validOrderSequence(request.resource.data.eventDate,request.resource.data.orderNumber,orderId)
        && (!('archived' in request.resource.data) || request.resource.data.archived == false)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && canOrderFor(request.resource.data.get('eventId', request.resource.data.eventDate))
        && ('eventTitle' in request.resource.data)
        && request.resource.data.eventTitle ==
          get(/databases/$(database)/documents/events/$(request.resource.data.get('eventId',request.resource.data.eventDate))).data.title;

      allow update: if orderShape(request.resource.data)
        && (
          (request.resource.data.eventDate == resource.data.eventDate
            && request.resource.data.get('orderNumber',0) == resource.data.get('orderNumber',0))
          || (request.resource.data.eventDate != resource.data.eventDate
            && validOrderSequence(request.resource.data.eventDate,request.resource.data.orderNumber,orderId))
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.email == resource.data.email
        && (request.resource.data.customerName == resource.data.customerName || isAdmin())
        && (request.resource.data.customerPhone == resource.data.customerPhone || isAdmin())
        && request.resource.data.updatedAt == request.time
        && (
          // Посетитель редактирует данные только до подтверждения администратором.
          (
            ownerOfOrder(resource.data)
            && resource.data.status == 'pending'
            && (!('archived' in resource.data) || resource.data.archived == false)
            && (
              (
                request.resource.data.status == 'pending'
                && canOrderFor(request.resource.data.get('eventId', request.resource.data.eventDate))
                && request.resource.data.get('eventTitle', '') ==
                  get(/databases/$(database)/documents/events/$(request.resource.data.get('eventId',request.resource.data.eventDate))).data.title
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['eventDate','eventId','eventTitle','orderNumber','tableNumber','bookingId','notes','updatedAt'])
              )
              || (
                request.resource.data.status == 'cancelled'
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status','updatedAt'])
              )
            )
          )
          ||
          // Администратор редактирует заказ без права менять владельца и email.
          (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'customerName','customerPhone','eventDate','eventId','eventTitle','orderNumber','tableNumber','bookingId',
                  'notes','status','archived','updatedAt'
                ])
            && (
              !('archived' in request.resource.data)
              || request.resource.data.archived == false
              || request.resource.data.status == 'cancelled'
            )
          )
        );

      allow delete: if false;

      match /items/{menuId} {
        function parentPath() {
          return /databases/$(database)/documents/orders/$(orderId);
        }
        function ownEditableOrder() {
          return request.auth != null
            && request.auth.token.email_verified == true
            && getAfter(parentPath()).data.ownerUid == request.auth.uid
            && getAfter(parentPath()).data.status == 'pending'
            && canOrderFor(getAfter(parentPath()).data.get('eventId',getAfter(parentPath()).data.eventDate));
        }
        function validItem(data) {
          return data.keys().hasAll(['id','name','unitPrice','quantity'])
            && data.keys().hasOnly(['id','name','unitPrice','quantity'])
            && data.id is int && data.id > 0
            && menuId == string(data.id)
            && data.quantity is int
            && data.quantity >= 1 && data.quantity <= 50
            && exists(/databases/$(database)/documents/menu/$(menuId))
            && get(/databases/$(database)/documents/menu/$(menuId)).data.available == true
            && data.name == get(/databases/$(database)/documents/menu/$(menuId)).data.name
            && data.unitPrice == get(/databases/$(database)/documents/menu/$(menuId)).data.price;
        }
        allow get, list: if isAdmin() || (
          request.auth != null && request.auth.token.email_verified == true
          && get(parentPath()).data.ownerUid == request.auth.uid
        );
        allow create, update: if (ownEditableOrder() || isAdmin())
          && validItem(request.resource.data);
        allow delete: if ownEditableOrder() || isAdmin();
      }
    }

    // FUTURE BALI ID bonus transfers. Cloud Functions must perform BOTH wallet
    // updates and the audit entry in one server-side Firestore transaction.
    // NEVER allow a browser (including directors) to write these documents.
    match /guestWallets/{uid} {
      allow get: if signedInAs(uid) || isAdmin() || isDirector();
      allow list, create, update, delete: if false;
    }
    match /bonusTransfers/{transferId} {
      allow read, write: if false;
    }
    match /baliTransferInbox/{uid}/items/{transferId} {
      allow get, list: if signedInAs(uid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
