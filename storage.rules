rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    // Public club imagery only. No guest data or arbitrary files in this prefix.
    match /public/{uid}/{kind}/{file} {
      allow read: if true;
      allow create: if admin() && request.auth.uid == uid
        && kind.matches('^[a-z-]{1,40}$') && file.matches('^[a-f0-9]{64}[.]webp$')
        && request.resource.size > 0 && request.resource.size <= 180000
        && request.resource.contentType == 'image/webp';
      // Content-addressed files are immutable. Deletion belongs to a separate cleanup job.
      allow update, delete: if false;
    }
    match /{path=**} {allow read, write: if false;}
  }
}
